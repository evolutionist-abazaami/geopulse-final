# ---------------------------------------------------------------------------
# GeoPulse — frontend (Vite, build-time, PUBLIC values only)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your anon / publishable key>
VITE_SUPABASE_PROJECT_ID=<your-project-ref>

# ---------------------------------------------------------------------------
# Edge Functions (server-side secrets: `supabase secrets set --env-file .env`)
# ---------------------------------------------------------------------------
# Injected automatically by Supabase — do NOT set manually when using Supabase:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_DB_URL

# Required for all AI features (chat, satellite analysis, search, files, hazards)
GEMINI_API_KEY=<Google AI Studio key>

# Required for real Landsat / satellite imagery analysis
GOOGLE_EARTH_ENGINE_API_KEY=<GEE service account JSON or API key>

# ---------------------------------------------------------------------------
# REMOVE after migration — Lovable-only, has no meaning outside Lovable Cloud
# ---------------------------------------------------------------------------
# LOVABLE_API_KEY
